# URL pública da API GlowHub (sem barra no fim).
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Aparelho físico: use o IP da sua máquina na rede (ex.: http://192.168.0.10:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Tenant do booking público (a vitrine usa "demo"; em produção, o slug do salão).
EXPO_PUBLIC_TENANT_SLUG=demo

# Project ID do EAS para push (opcional; `npx eas-cli init` grava em app.json).
# Sem ele o app funciona, mas mostra push como indisponível.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
