# ===== Neon (Postgres) =====
# Console > Connect: role admin (neondb_owner). Migrations/admin (ignora RLS).
DATABASE_URL=

# Conexao com a role de app (LOGIN, SEM BYPASSRLS). Queries do app (aplica RLS).
# Se a senha tiver caracteres especiais (+, /, =), faca percent-encoding na URL.
DATABASE_AUTHENTICATED_URL=

# ===== Better Auth (self-hosted no Next) =====
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Origens extras confiaveis (CSRF), separadas por virgula. Opcional.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.seudominio.com,https://painel.seudominio.com

# ===== Multi-tenant =====
# Dominio raiz usado para resolver o tenant por subdominio (<tenant>.SEU_DOMINIO)
NEXT_PUBLIC_ROOT_DOMAIN=glowhub.app
# Tenant usado como fallback em localhost (ou ?tenant=slug)
DEFAULT_TENANT_SLUG=demo

# ===== Cron (Vercel) =====
# Autoriza GET /api/cron/subscriptions (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ===== Webhooks de pagamento =====
# Segredo global (fallback) ou por provedor: WEBHOOK_<PROVIDER>_SECRET.
# Ex.: WEBHOOK_STRIPE_SECRET. A assinatura HMAC-SHA256 do corpo e enviada em
# `x-webhook-signature` (sha256=<hex> ou <hex>). Sem segredo, o endpoint rejeita.
WEBHOOK_SECRET=

# ===== Conta demo (botao "Entrar com conta demo" no login) =====
# Desativado por padrao. Para habilitar, defina NEXT_PUBLIC_DEMO_LOGIN=true E
# DEMO_PASSWORD (a action valida os dois no servidor, nao apenas o botao).
NEXT_PUBLIC_DEMO_LOGIN=false
# DEMO_EMAIL=demo@glowhub.app
DEMO_PASSWORD=
# DEMO_TENANT_SLUG=demo
