# ===== Neon (Postgres) =====
# Console > Connect: role admin (neondb_owner). Migrations/admin (ignora RLS).
DATABASE_URL=

# Conexao com a role de app (LOGIN, SEM BYPASSRLS). Queries do app (aplica RLS).
# Se a senha tiver caracteres especiais (+, /, =), faca percent-encoding na URL.
DATABASE_AUTHENTICATED_URL=

# ===== Better Auth (self-hosted no Next) =====
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Origens extras confiaveis (CSRF), separadas por virgula. Opcional.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.seudominio.com,https://painel.seudominio.com

# ===== Multi-tenant =====
# Dominio raiz usado para resolver o tenant por subdominio (<tenant>.SEU_DOMINIO)
NEXT_PUBLIC_ROOT_DOMAIN=glowhub.app
# Tenant usado como fallback em localhost (ou ?tenant=slug)
DEFAULT_TENANT_SLUG=demo

# ===== Cron (Vercel) =====
# Autoriza GET /api/cron/subscriptions (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ===== Modo demonstração =====
# Producao: tenant demo somente leitura (catalogo/financeiro/config).
# Defina DEMO_READ_ONLY=false em ambientes de teste/preview para permitir as
# escritas congeladas (exceção de teste). Ausente = somente leitura.
# DEMO_READ_ONLY=true

# ===== Webhooks de pagamento =====
# Segredo global (fallback) ou por provedor: WEBHOOK_<PROVIDER>_SECRET.
# Ex.: WEBHOOK_STRIPE_SECRET. A assinatura HMAC-SHA256 do corpo e enviada em
# `x-webhook-signature` (sha256=<hex> ou <hex>). Sem segredo, o endpoint rejeita.
WEBHOOK_SECRET=

# ===== Pagamento online (gateway) =====
# Provedor ativo: `mock` (padrao, para dev/testes) ou `mercadopago`.
PAYMENT_PROVIDER=mock
# URL publica da app: usada nos links de checkout e nas back_urls do provedor.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mercado Pago (Checkout Pro): access token (sandbox/producao).
# MERCADO_PAGO_ACCESS_TOKEN=
# Segredo do webhook do Mercado Pago (header x-signature). URL:
# /api/webhooks/mercadopago
# WEBHOOK_MERCADOPAGO_SECRET=

# ===== Metricas e alertas externos =====
# Toda metrica/erro ja sai como log JSON estruturado (coletavel por log drain).
# Opcionalmente, empurre as metricas para um coletor HTTP (Axiom/Datadog/etc.):
# METRICS_WEBHOOK_URL=https://.../ingest
# Autoriza o scrape GET /api/metrics (Authorization: Bearer <token>). Sem token,
# o endpoint responde 404 (nao expoe nada por padrao).
# METRICS_TOKEN=
# Alertas: webhook compativel com Slack/Discord/Mattermost. Nivel minimo
# (warn|error|critical; padrao error) e supressao de alertas repetidos por titulo
# (segundos; padrao 300).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_MIN_LEVEL=error
# ALERT_COOLDOWN_SECONDS=300

# ===== Conta demo (botao "Entrar com conta demo" no login) =====
# Desativado por padrao. Para habilitar, defina NEXT_PUBLIC_DEMO_LOGIN=true E
# DEMO_PASSWORD (a action valida os dois no servidor, nao apenas o botao).
NEXT_PUBLIC_DEMO_LOGIN=false
# DEMO_EMAIL=demo@glowhub.app
DEMO_PASSWORD=
# DEMO_TENANT_SLUG=demo
